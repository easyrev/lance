This unadopted patch records the two Parquet scanner variants used in the
Stage 3 experiment. The variants were applied as child-process monkey patches.
They were not committed because neither qualified on every required cell.

Target: python/python/lance/types.py

--- a/python/python/lance/types.py
+++ b/python/python/lance/types.py
@@
 @_coerce_source.register(pa.dataset.Dataset)
 def _arrow_dataset_source(data_obj: pa.dataset.Dataset, schema=None) -> _WriteSource:
+    # Unadopted variant (a): limit decode fan-out and fragment I/O.
+    scan_options = {"batch_readahead": 1, "fragment_readahead": 1}
+
+    # Unadopted variant (b): use one readahead batch and a 64 MiB row budget.
+    # The row count comes from Parquet metadata uncompressed bytes per row:
+    # rows = max(1, (64 MiB) // uncompressed_bytes_per_row)
+    # scan_options = {
+    #     "batch_size": rows,
+    #     "batch_readahead": 1,
+    #     "fragment_readahead": 1,
+    # }
+
-    scanner = pa.dataset.Scanner.from_dataset(data_obj)
+    scanner = pa.dataset.Scanner.from_dataset(data_obj, **scan_options)
     return _WriteSource(
         scanner.projected_schema,
         scanner.to_reader,
         "replayable" if _arrow_dataset_replayable(data_obj) else "streaming",
     )

