+    }
+
+    #[tokio::test]
+    async fn payload_take_error_is_not_an_empty_success() {
+        let dataset = Arc::new(
+            gen_batch()
+                .col("key", array::step::<UInt64Type>())
+                .col("old", array::step::<UInt64Type>())
