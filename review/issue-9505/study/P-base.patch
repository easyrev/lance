+            blobs[1].as_ref().unwrap().read().await.unwrap().to_vec(),
+            blobs[2].as_ref().unwrap().read().await.unwrap().to_vec(),
+        ];
+        rewritten.sort();
+        assert_eq!(rewritten, [b"baz".to_vec(), b"qux".to_vec()]);
     }
 
