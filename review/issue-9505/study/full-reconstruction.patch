+}
+impl ExecutionPlan for TargetStatistics {
+    fn name(&self) -> &str {
+        "ProbeTargetStatistics"
+    }
+    fn properties(&self) -> &Arc<PlanProperties> {
+        self.input.properties()
+    }
+    fn children(&self) -> Vec<&Arc<dyn ExecutionPlan>> {
+        vec![&self.input]
+    }
+    fn maintains_input_order(&self) -> Vec<bool> {
+        vec![true]
+    }
+    fn with_new_children(
+        self: Arc<Self>,
+        mut c: Vec<Arc<dyn ExecutionPlan>>,
+    ) -> datafusion::error::Result<Arc<dyn ExecutionPlan>> {
+        assert_eq!(c.len(), 1);
+        Ok(Arc::new(Self {
+            input: c.remove(0),
+            bytes: self.bytes,
+            mask_rows: self.mask_rows,
+        }))
+    }
+    fn partition_statistics(
+        &self,
+        partition: Option<usize>,
+    ) -> datafusion::error::Result<Arc<Statistics>> {
+        let mut stats = self.input.partition_statistics(partition)?.as_ref().clone();
+        stats.total_byte_size = self
+            .bytes
+            .map(Precision::Inexact)
+            .unwrap_or(Precision::Absent);
+        if self.mask_rows {
+            stats.num_rows = Precision::Absent;
+        }
+        Ok(Arc::new(stats))
+    }
+    fn execute(
+        &self,
+        p: usize,
+        c: Arc<TaskContext>,
+    ) -> datafusion::error::Result<SendableRecordBatchStream> {
+        self.input.execute(p, c)
+    }
+}
