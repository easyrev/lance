+fn row_bytes(batch: &RecordBatch, index: usize) -> ProbeResult<usize> {
+    let mut bytes = 0;
+    for array in batch.columns() {
+        bytes += match array.data_type() {
+            DataType::Int64 | DataType::UInt64 => 9,
+            DataType::Binary => {
+                if array.is_null(index) {
+                    5
+                } else {
+                    array.as_binary::<i32>().value(index).len() + 5
+                }
+            }
+            DataType::LargeBinary => {
+                if array.is_null(index) {
+                    9
+                } else {
+                    array.as_binary::<i64>().value(index).len() + 9
+                }
+            }
+            DataType::Utf8 => {
+                if array.is_null(index) {
+                    5
+                } else {
+                    array.as_string::<i32>().value(index).len() + 5
+                }
+            }
+            DataType::LargeUtf8 => {
+                if array.is_null(index) {
+                    9
+                } else {
+                    array.as_string::<i64>().value(index).len() + 9
+                }
+            }
+            other => return Err(format!("Byte-split spike does not implement {other:?}").into()),
+        };
+    }
+    Ok(bytes)
+}
