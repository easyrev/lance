+async fn take_probe(spec: &Value, dir: &std::path::Path) -> ProbeResult<Value> {
+    let dataset = Arc::new(Dataset::open(spec["fixture"].as_str().unwrap()).await?);
+    let (budget, pool, _) = context(spec, &dataset, dir)?;
+    let ctx = &budget.session_ctx;
+    let target = ctx
+        .read_table(Arc::new(
+            crate::datafusion::dataframe::LanceTableProvider::new_with_ordering(
+                dataset.clone(),
+                true,
+                true,
+                false,
+            ),
+        ))?
+        .alias("target")?;
+    let source = ctx.read_table(provider(spec, dir)?)?.alias("source")?;
+    let joined = target.join(source, JoinType::Inner, &["id"], &["id"], None)?;
+    let early = spec["take_mode"] == "early";
+    let mut fields = vec![
+        logical_expr::col("source.id").alias("id"),
+        logical_expr::col("source.c0").alias("c0"),
+        logical_expr::col("source.c1").alias("c1"),
+        logical_expr::col("target._rowaddr").alias(ROW_ADDR),
+        logical_expr::lit(true).alias(MERGE_SOURCE_SENTINEL),
+        logical_expr::lit(1u8).alias(MERGE_ACTION_COLUMN),
+    ];
+    let missing = dataset
+        .schema()
+        .fields
+        .iter()
+        .filter(|f| !["id", "c0", "c1"].contains(&f.name.as_str()))
+        .map(|f| f.name.clone())
+        .collect::<Vec<_>>();
+    if early {
+        fields.extend(
+            missing
+                .iter()
+                .map(|n| logical_expr::col(format!("target.{n}")).alias(n)),
+        );
+    }
+    let frame = joined.select(fields)?;
+    let input = frame.create_physical_plan().await?;
+    let plan: Arc<dyn ExecutionPlan> = match spec["take_mode"].as_str().unwrap() {
+        "condition" => Arc::new(
+            deferred_reference::MergeConditionExec::try_new(
+                input.clone(),
+                &DFSchema::try_from(input.schema().as_ref().clone())?,
+                dataset.clone(),
+                None,
+                None,
+                &ctx.state(),
+            )?
+            .with_payload_columns(missing.clone())?,
+        ),
+        "generic" => {
+            let projection = missing
+                .iter()
+                .try_fold(dataset.empty_projection(), |p, n| {
+                    p.union_column(n, lance_core::datatypes::OnMissing::Error)
+                })?;
+            Arc::new(
+                crate::io::exec::TakeExec::try_new(dataset.clone(), input, projection)?.unwrap(),
+            )
+        }
+        "early" => input,
+        other => return Err(format!("unknown take mode {other}").into()),
+    };
+    std::fs::write(
+        dir.join("plan-before.txt"),
+        format!("{}", displayable(plan.as_ref()).indent(true)),
+    )?;
+    let partitions = plan.properties().output_partitioning().partition_count();
+    let cpu = process_cpu();
+    let io_before = process_io();
+    let started = Instant::now();
+    let tasks = (0..partitions).map(|p| {
+        let plan = plan.clone();
+        let context = ctx.task_ctx();
+        let path = dir.join(format!("output-{p}.arrow"));
+        async move {
+            let mut s = plan.execute(p, context)?;
+            let mut writer = FileWriter::try_new(File::create(path)?, plan.schema().as_ref())?;
+            let mut rows = 0;
+            let mut batches = 0;
+            while let Some(batch) = s.try_next().await? {
+                rows += batch.num_rows();
+                batches += 1;
+                writer.write(&batch)?;
+            }
+            writer.finish()?;
+            Ok::<_, Box<dyn std::error::Error + Send + Sync>>(
+                json!({"partition":p,"rows":rows,"batches":batches}),
+            )
+        }
+    });
+    let result = futures::future::try_join_all(tasks).await;
+    let seconds = started.elapsed().as_secs_f64();
+    let cpu_seconds = process_cpu() - cpu;
+    let io = process_io()
+        .into_iter()
+        .map(|(k, v)| {
+            let diff = v - io_before.get(&k).copied().unwrap_or(0);
+            (k, diff)
+        })
+        .collect::<BTreeMap<_, _>>();
+    let mut metrics = Vec::new();
+    collect_metrics(&plan, "0".into(), &mut metrics);
+    save(dir.join("operator-metrics.json"), &json!(metrics))?;
+    match result {
+        Ok(distribution) => Ok(
+            json!({"status":"success","distribution":distribution,"merge_seconds":seconds,"cpu_seconds":cpu_seconds,"io_delta":io,"pool":pool.snapshot(),"timing_scope":"Actual Lance/DF join and payload node plus common IPC sink; no writer, commit, NULL-address or conditional-rule implementation"}),
+        ),
+        Err(error) => Ok(
+            json!({"status":"execution_error","error":error.to_string(),"merge_seconds":seconds,"cpu_seconds":cpu_seconds,"io_delta":io,"pool":pool.snapshot()}),
+        ),
+    }
+}
