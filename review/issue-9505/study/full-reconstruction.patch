+    fn join_output_retains(plan: &str, column: &str) -> bool {
+        let lines: Vec<&str> = plan.lines().collect();
+        let Some(join) = lines.iter().position(|line| line.contains("HashJoinExec")) else {
+            return false;
+        };
+        let above = lines[..join]
+            .iter()
+            .rev()
