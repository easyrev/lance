+        // Execute this node directly with one input partition. A merge join
+        // could reorder the addresses and would not prove the intended sequence.
+        let exec = MergeConditionExec::try_new(
+            TestMemoryExec::try_new_exec(&[vec![input.clone()]], input.schema(), None).unwrap(),
