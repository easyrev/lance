+        let batches = collect(exec.clone(), session.task_ctx()).await.unwrap();
+        assert_eq!(batches.len(), 8);
+        for batch in &batches {
+            assert_eq!(batch.num_rows(), 1);
+            assert_eq!(batch["payload"].null_count(), 1);
