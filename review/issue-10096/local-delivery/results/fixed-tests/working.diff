+#[derive(Clone, Copy)]
+enum StagedHistoryChange {
+    UpdatedSource,
+    UnrelatedColumn,
+    FoldedOverlay,
+    MissingBuild,
+    MissingInputs,
+    MissingRewrite,
+    Chained,
+    PartialGroup,
+}
+
+#[rstest]
+#[case::updated_source(StagedHistoryChange::UpdatedSource)]
+#[case::unrelated_column(StagedHistoryChange::UnrelatedColumn)]
+#[case::folded_overlay(StagedHistoryChange::FoldedOverlay)]
+#[case::missing_build(StagedHistoryChange::MissingBuild)]
+#[case::missing_inputs(StagedHistoryChange::MissingInputs)]
+#[case::missing_rewrite(StagedHistoryChange::MissingRewrite)]
+#[case::chained(StagedHistoryChange::Chained)]
+#[case::partial_group(StagedHistoryChange::PartialGroup)]
+#[tokio::test]
+async fn test_staged_index_checks_values_and_history(#[case] change: StagedHistoryChange) {
+    let dir = TempStrDir::default();
+    let uri = dir.as_str();
+    let mut table = indexed_table(uri, 4).await;
+    let built = table.manifest.version;
+    let fragments = if matches!(change, StagedHistoryChange::PartialGroup) {
+        vec![0]
+    } else {
+        vec![0, 1, 2, 3]
+    };
+    let segment = table
+        .create_index_builder(&["val"], IndexType::BTree, &ScalarIndexParams::default())
+        .name("val_idx".into())
+        .fragments(fragments)
+        .execute_uncommitted()
+        .await
+        .unwrap();
+    match change {
+        StagedHistoryChange::UpdatedSource => {
+            update_in_place(table, vec![0, 6], vec![999, 60]).await;
+            table = open_in_new_session(uri).await;
+        }
+        StagedHistoryChange::UnrelatedColumn => {
+            let patch = record_batch!(("id", Int32, vec![0]), ("spare", Int32, vec![999])).unwrap();
+            let schema = patch.schema();
+            let mut merge =
+                MergeInsertBuilder::try_new(Arc::new(table), vec!["id".into()]).unwrap();
+            merge
+                .when_matched(WhenMatched::UpdateAll)
+                .when_not_matched(WhenNotMatched::DoNothing)
+                .write_mode(MergeInsertWriteMode::RewriteColumns);
+            merge
+                .try_build()
+                .unwrap()
+                .execute_reader(RecordBatchIterator::new([Ok(patch)], schema))
+                .await
+                .unwrap();
+            table = open_in_new_session(uri).await;
+        }
+        StagedHistoryChange::FoldedOverlay => {
+            table = overlay_val(table, 0, 999).await;
+        }
+        StagedHistoryChange::MissingInputs => {
+            table
+                .update_config([("before_compaction", "true")])
+                .await
+                .unwrap();
+        }
+        _ => {}
+    }
+    let inputs = table.manifest.version;
+    let options = if matches!(change, StagedHistoryChange::FoldedOverlay) {
+        folding_compaction(2)
+    } else {
+        deferred_compaction(2)
+    };
+    compact_files(&mut table, options, None).await.unwrap();
+    let rewrite = table.manifest.version;
+    assert!(rewrite > inputs);
+    match change {
+        StagedHistoryChange::Chained => {
+            compact_files(&mut table, deferred_compaction(4), None)
+                .await
+                .unwrap();
+        }
+        StagedHistoryChange::MissingBuild => clean_up_versions(uri, vec![built]).await,
+        StagedHistoryChange::MissingInputs => clean_up_versions(uri, vec![inputs]).await,
+        StagedHistoryChange::MissingRewrite => {
+            table
+                .update_config([("after_compaction", "true")])
+                .await
+                .unwrap();
+            clean_up_versions(uri, vec![rewrite]).await;
+        }
+        _ => {}
+    }
+    let mut publisher = open_in_new_session(uri).await;
+    publisher
+        .commit_existing_index_segments("val_idx", "val", vec![segment])
+        .await
+        .unwrap();
+    assert_lookups_match_scan(uri, probes(24, [999])).await;
+    match change {
+        StagedHistoryChange::UpdatedSource | StagedHistoryChange::FoldedOverlay => {
+            assert_covers_all_but_the_fragment_of(uri, Some(0)).await;
+        }
+        StagedHistoryChange::Chained | StagedHistoryChange::UnrelatedColumn => {
+            assert_covers_all_but_the_fragment_of(uri, None).await
+        }
+        _ => assert!(
+            coverage(uri, "val_idx")
+                .await
+                .is_disjoint(&live_fragments(uri).await)
+        ),
+    }
+}
