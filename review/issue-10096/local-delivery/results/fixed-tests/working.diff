+#[rstest]
+#[case::update(Racing::UpdateInPlace)]
+#[case::cleanup(Racing::RemapAndTrim)]
+#[tokio::test]
+async fn test_staged_index_publication_retry_keeps_provenance(#[case] racing: Racing) {
+    let dir = TempStrDir::default();
+    let uri = dir.as_str().to_string();
+    let mut table = indexed_table(&uri, 4).await;
+    let built = table.manifest.version;
+    let segment = table
+        .create_index_builder(&["val"], IndexType::BTree, &ScalarIndexParams::default())
+        .name("val_idx".into())
+        .execute_uncommitted()
+        .await
+        .unwrap();
+    compact_files(&mut table, deferred_compaction(2), None)
+        .await
+        .unwrap();
+    let hook_uri = uri.clone();
+    let hook = Box::pin(async move {
+        let mut table = open_in_new_session(&hook_uri).await;
+        match racing {
+            Racing::UpdateInPlace => update_in_place(table, vec![0], vec![999]).await,
+            Racing::RemapAndTrim => {
+                remapping::remap_column_index(&mut table, &["id"], Some("id_idx".into()))
+                    .await
+                    .unwrap();
+                cleanup_frag_reuse_index(&mut table).await.unwrap();
+            }
+            _ => unreachable!(),
+        }
+    });
+    let (mut publisher, race) = builder_racing(&uri, hook).await;
+    publisher
+        .commit_existing_index_segments("val_idx", "val", vec![segment])
+        .await
+        .unwrap();
+    assert_eq!(race.attempts.load(Ordering::SeqCst), 2);
+    assert_lookups_match_scan(&uri, probes(24, [999])).await;
+    if matches!(racing, Racing::RemapAndTrim) {
+        assert!(
+            coverage(&uri, "val_idx")
+                .await
+                .is_disjoint(&live_fragments(&uri).await)
+        );
+    } else {
+        assert_covers_all_but_the_fragment_of(&uri, Some(0)).await;
+    }
+    let latest = open_in_new_session(&uri).await;
+    let raw = lance_table::io::manifest::read_manifest_indexes(
+        &latest.object_store,
+        &latest.manifest_location,
+        &latest.manifest,
+    )
+    .await
+    .unwrap();
+    let raw = raw
+        .iter()
+        .find(|segment| segment.name == "val_idx")
+        .unwrap();
+    assert_eq!(raw.dataset_version, built);
+    let expected = if matches!(racing, Racing::RemapAndTrim) {
+        0..4
+    } else {
+        2..4
+    };
+    assert_eq!(
+        *raw.fragment_bitmap.as_ref().unwrap(),
+        RoaringBitmap::from_iter(expected)
+    );
+}
